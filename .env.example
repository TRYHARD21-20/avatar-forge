PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Supply a long random secret for any persistent use
RECEIPT_SECRET=

# Set ONLY when hosting the realtime room server on a separate HTTPS service.
# In Vercel: Project > Settings > Environment Variables. Requires a redeploy.
# Example: https://your-room-backend.onrender.com
VITE_REALTIME_ORIGIN=
